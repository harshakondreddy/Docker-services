# Copy to .env and fill in. Never commit .env.

# RDP login created inside Windows on first boot
RDP_USER=<your-rdp-username>
RDP_PASS=<your-strong-password>

# Windows edition: 11, 10, 2022, 2019
WINDOWS_VERSION=11

# VM resources
RAM_SIZE=4G
CPU_CORES=2
DISK_SIZE=64G

# Container limits
MEM_LIMIT=6g
CPU_LIMIT=4

# Ports (127.0.0.1 keeps them off the network; use an SSH tunnel)
BIND_ADDR=127.0.0.1
RDP_PORT=3389
VNC_PORT=8006
